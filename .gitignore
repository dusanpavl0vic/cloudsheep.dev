# Generisani artefakti
# sitemap.xml pravi scripts/build-sitemap.mjs iz ruta i slug-ova pri svakom buildu.
# Commit-ovan bi bio drugi izvor istine koji tiho zastari.
apps/web/public/sitemap.xml

# Izvezeni logotipi (`brand/README.md`)
# Kopije marke iz `packages/ui/src/atoms/Logo/SheepMark.tsx`, za upotrebu van koda.
# Ne prate se: izvor je komponenta, a dva izvora istine se tiho raziđu. Regenerišu se ručno.
brand/

# Deploy

# Env
# `.env.example` je ugovor i JESTE praćen; sve ostalo nosi stvarne vrednosti.
# Nijedan obrazac nema kosu crtu, pa negacija važi i u `apps/*/`.
.env
.env.*
!.env.example
*.local

# Tajne koje ne smeju u repo ni slučajno
*.pem
*.key
*.p12
*.pfx

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.history/
*.swp
*.swo

# Lični alati
# Timski `.claude/settings.json` se prati; `settings.local.json` je po korisniku.
# Do sad ga je hvatao samo globalni ~/.config/git/ignore, pa na tuđem kloniranju
# i u CI-ju nije bio pokriven — pravilo mora da putuje sa repoom.
.claude/settings.local.json

# Drugi paket menadžeri
# Repo je isključivo pnpm (`packageManager` u package.json). Ovi fajlovi ovde
# znače da je neko pokrenuo pogrešnu komandu, i ne smeju da se commit-uju.
package-lock.json
yarn.lock
bun.lockb
.yarn/
.pnp.*


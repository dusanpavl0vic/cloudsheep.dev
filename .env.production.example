# PRODUKCIJA. Spisak onoga što se rukom upisuje u Coolify → aplikacija → Environment Variables.
#
# Ovaj fajl se NE kopira u `.env` i nijedan proces ga ne čita — on je podsetnik, ne izvor.
# Prava vrednost nikad ne ide u repo (`infra/COOLIFY.md`). Za lokalni rad: `.env.example`.
#
# ═══════════════════════════════════════════════════════════════════════════════
# BUILD-TIME — postavlja ih CI (`.github/workflows/ci.yml`, build-args), NE Coolify
# ═══════════════════════════════════════════════════════════════════════════════
#
# Next ugrađuje NEXT_PUBLIC_* u JS pri build-u image-a; u Coolify-ju ne menjaju ništa.
# Javno su čitljive — nikad tajna.
#   NEXT_PUBLIC_SITE_URL=https://cloudsheep.dev
#   NEXT_PUBLIC_APP_ENV=production
#
# ═══════════════════════════════════════════════════════════════════════════════
# RUNTIME — Coolify
# ═══════════════════════════════════════════════════════════════════════════════
#
# NODE_ENV, PORT, UPLOAD_DIR i NODE_OPTIONS su već u image-u (Dockerfile) — ne postavljaj ih.

# Interna adresa Postgres resursa (Coolify → baza → Internal URL). Baza nema javni port.
DATABASE_URL=postgresql://postgres:LOZINKA@cloudsheep-db:5432/postgres

# Minimum 32 znaka (proverava se pri prvom zahtevu). Generiši: openssl rand -base64 32
# Novi ključ odjavljuje sve postojeće sesije.
JWT_SECRET=

# Mejl — OBAVEZNO u produkciji: bez njega posetilac ne dobija link za potvrdu adrese, pa upit
# i prijava na newsletter ne prolaze (ADR 0016). SMTP_PASS je Google App Password
# (nalog → Security → 2-Step Verification → App passwords), NIKAD obična lozinka.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cloudsheep.dev016@gmail.com
SMTP_PASS=
# Gde stižu potvrđeni upiti.
CONTACT_TO=cloudsheep.dev016@gmail.com

# Prvi admin nalog — koristi se SAMO kad je baza prazna (seed `--if-empty` pri startu).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Opciono, imaju razumne podrazumevane vrednosti (`src/server/env.ts`):
# PUBLIC_UPLOAD_BASE=            (prazno = isto poreklo, /uploads/…)
# MAX_UPLOAD_BYTES=5242880
# ACCESS_TOKEN_TTL=15m
# REFRESH_TTL_DAYS=1
# REFRESH_TTL_DAYS_REMEMBERED=30

{
  // Testovi imaju sopstveni projekat, odvojen od `tsconfig.app.json`.
  //
  // Razlog: `tsconfig.app.json` EMITUJE u `dist`, a `dist` ide u produkcioni image kroz
  // `files` polje. Da su testovi tamo, u image bi otišao i test kod koji uvozi `supertest`
  // (kojeg u produkciji nema), a `vitest` bi svaki test nalazio dvaput — jednom u `src`,
  // jednom u `dist`.
  //
  // Prosto isključivanje iz `tsconfig.app.json` nije dovoljno: `projectService` u ESLint-u
  // onda ne zna kom projektu fajl pripada i javlja „was not found by the project service".
  // Zato zaseban projekat koji ih uključuje i REFERIŠE aplikaciju, pa se uvozi razrešavaju.
  "extends": "@app/typescript-config/node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "composite": true,
    // BEZ `rewriteRelativeImportExtensions`, za razliku od `tsconfig.app.json`.
    // Ovaj projekat ne emituje, pa nema šta da prepisuje — a sa uključenim prepisivanjem
    // `tsc` odbija uvoz preko granice projekta (TS2878): izlazne putanje dva projekta ne
    // stoje u istom odnosu kao ulazne, jer testovi nemaju `outDir`.
    "noEmit": true
  },
  "include": ["src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.app.json" }]
}

# Kopiraj u `.env` za lokalni rad: cp .env.example .env
#
# Za razliku od `apps/web` i `apps/admin`, ovde NEMA `VITE_` prefiksa i ništa od ovoga
# ne sme završiti u bundle-u koji ide pretraživaču — ovo su tajne (docs/20-security.md).
#
# `src/env.ts` sve validira zodom pri startu i puca glasno ako nešto fali.
# Produkcione vrednosti žive samo u Coolify UI-ju (`infra/COOLIFY.md`).

NODE_ENV=development
PORT=3000

# Lokalni Postgres. Najbrže: docker run -d --name cs-pg -p 5432:5432 \
#   -e POSTGRES_PASSWORD=app -e POSTGRES_USER=app -e POSTGRES_DB=appdb postgres:17-alpine
DATABASE_URL=postgresql://app:app@localhost:5432/appdb

# Minimum 32 znaka. Generiši: openssl rand -base64 32
JWT_SECRET=lokalni-kljuc-za-razvoj-mora-imati-32-znaka

# Odakle se sme zvati API. Comma-separated, bez zvezdice.
#
# 5173 je `web`, 5174 je `admin`. Dodatna dva su tu jer Vite AUTO-INKREMENTIRA port kad
# je zauzet: zaboravljen dev server od juče gurne `admin` na 5175, prijava pukne na CORS-u,
# a poruka u konzoli ne kaže da je uzrok port. Jeftinije je dozvoliti ih unapred.
#
# 4173 je `vite preview`, dakle port na kome se vozi CEO Playwright paket
# (`apps/web/playwright.config.ts`). Bez njega layout loader ne može da dohvati profil, pa
# padne svaki test koji uopšte otvori stranicu — a greška se prijavi kao „h1 nije nađen",
# što ne pominje ni CORS ni port. 4174 je isti slučaj za `admin` preview.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:4173,http://localhost:4174

# PRAZNO lokalno — `Domain=.localhost` pretraživač odbacuje, pa cookie ne bi stigao.
# U produkciji: .cloudsheep.dev
COOKIE_DOMAIN=

# Otpremljene datoteke. Lokalno je relativni folder, u kontejneru montiran volumen.
UPLOAD_DIR=./uploads
# Puna adresa API-ja, SA shemom i portom — sajt i API nisu na istom poreklu, pa relativna
# putanja ne radi ni lokalno. Pogrešna vrednost = prazne slike BEZ greške u konzoli.
PUBLIC_UPLOAD_BASE=http://localhost:3000
# MAX_UPLOAD_BYTES=5242880

# Kontakt forma — SMTP.
#
# `SMTP_PASS` je Google App Password (Google nalog → Security → App passwords; traži 2FA),
# NIKAD obična lozinka naloga. Bez ovih vrednosti poruka se i dalje upisuje u bazu i vidi
# u adminu — samo se mejl ne šalje.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Prvi admin nalog — bez njega se u `admin` panel ne može ući, jer registracije nema.
#
# Seed (`src/seed.ts`) se pokreće posle migracija i `upsert`-uje ovaj nalog. Idempotentan
# je: ponovno pokretanje ne menja postojeću lozinku, pa ne može slučajno da resetuje nalog.
# Ako varijable nisu postavljene, tiho se preskače.
#
# Lozinka mora imati bar 12 znakova i NIKAD ne ide u repo — ni ovde, ni u seed.
SEED_ADMIN_EMAIL=ti@primer.dev
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Opciono — ovo su podrazumevane vrednosti:
# ACCESS_TOKEN_TTL=15m
# REFRESH_TTL_DAYS=1
# REFRESH_TTL_DAYS_REMEMBERED=30

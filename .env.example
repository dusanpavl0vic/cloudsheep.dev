# Kopiraj u `.env` za lokalni rad: cp .env.example .env
#
# Serverske promenljive (bez NEXT_PUBLIC_) su TAJNE i nikad ne ulaze u bundle — čita ih samo
# `src/server/env.ts`, koji ih validira zod-om pri prvom zahtevu (docs/17-backend.md §2).
# Produkcione vrednosti žive samo u Coolify-u (`infra/COOLIFY.md`).

NODE_ENV=development

# Lokalni Postgres: docker compose -f infra/docker-compose.yml up -d db
DATABASE_URL=postgresql://app:app@localhost:5432/appdb

# Minimum 32 znaka. Vrednost ispod je namerno bez entropije — radi lokalno, a skener tajni
# je ne prijavljuje. Za produkciju: openssl rand -base64 32
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=1
REFRESH_TTL_DAYS_REMEMBERED=30

# Otpremljene slike. Lokalno relativni folder, u kontejneru montiran volumen.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# SMTP za kontakt formu. Sve OPCIONO: bez vrednosti se poruka upiše u bazu i ispiše u log
# umesto da se pošalje — `pnpm dev` radi bez Google App Password-a.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# Javne (ugrađuju se u bundle pri BUILD-u)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

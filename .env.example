# Ugovor o env varijablama za deploy. Prava vrednost NIKAD ne ide u repo —
# u produkciji žive samo u Coolify UI-ju (vidi `infra/COOLIFY.md`).
#
# Za lokalni dev postoje zasebni fajlovi po app-i: `apps/web/.env.example`,
# `apps/admin/.env.example`, `apps/api/.env.example`. Ovaj fajl je pogled na deploy.
#
# ═══════════════════════════════════════════════════════════════════════════════
# BUILD-TIME — Coolify: "Build Variables" (docker build args), NE Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Vite ove vrednosti UGRAĐUJE u JS bundle. Runtime env varijabla u kontejneru na njih
# ne utiče — bundle je već napravljen. Ovo je najčešća greška pri prelasku sa Vercela.
#
# Isto tako: pošto završe u bundle-u, javno su čitljive. Nikad tajna ovde.
#
# Važe za resurse `web` i `admin`:
VITE_API_URL=https://api.cloudsheep.dev
VITE_APP_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# RUNTIME — Coolify: "Environment Variables" na resursu `api`
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# Interna adresa Postgres resursa iz Coolify-a. Baza NEMA javni domen ni port —
# vidi se samo na Docker mreži, pa je hostname ime kontejnera, ne IP servera.
DATABASE_URL=postgresql://postgres:LOZINKA@cloudsheep-db:5432/postgres

# Allowlist, comma-separated, bez zvezdice. `credentials: true` uz `origin: *`
# pretraživač ionako odbija (`apps/api/src/app.ts`).
CORS_ORIGINS=https://cloudsheep.dev,https://www.cloudsheep.dev,https://admin.cloudsheep.dev

# Minimum 32 znaka (zod to proverava pri startu). Generiši: openssl rand -base64 32
JWT_SECRET=

# Vodeća tačka = cookie važi i za subdomene, pa `admin.` deli sesiju sa `api.`.
# Lokalno se ostavlja PRAZNO — `Domain=.localhost` pretraživač odbacuje.
COOKIE_DOMAIN=.cloudsheep.dev

# Otpremljene slike i logotipi tehnologija.
# `UPLOAD_DIR` mora pokazivati na montiran volumen, inače slike nestaju pri svakom deployu.
# `PUBLIC_UPLOAD_BASE` ulazi u `img-src` na sajtu — mora biti tačan do sheme.
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_BASE=https://api.cloudsheep.dev
# MAX_UPLOAD_BYTES=5242880

# Kontakt forma — SMTP.
#
# `SMTP_PASS` je Google App Password (Google nalog → Security → App passwords; traži 2FA),
# NIKAD obična lozinka naloga. Bez ovih vrednosti poruka se i dalje upisuje u bazu i vidi
# u adminu — samo se mejl ne šalje.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cloudsheep.dev016@gmail.com
SMTP_PASS=
CONTACT_TO=cloudsheep.dev016@gmail.com

# Prvi admin nalog. Pre-deployment komanda ga `upsert`-uje posle svake migracije, pa je
# u bazi odmah posle prvog deploya. Idempotentno: ne menja postojeći nalog ni lozinku.
# Bez ovih varijabli se seed tiho preskače i deploy svejedno prolazi.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Opciono, imaju razumne podrazumevane vrednosti (`apps/api/src/env.ts`):
# ACCESS_TOKEN_TTL=15m
# REFRESH_TTL_DAYS=1
# REFRESH_TTL_DAYS_REMEMBERED=30

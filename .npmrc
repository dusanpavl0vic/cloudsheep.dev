# Strict — nema phantom zavisnosti. Paket koji nije u package.json se ne može uvesti.
node-linker=isolated
strict-peer-dependencies=true

# Build skripte se izvršavaju samo za pakete koje eksplicitno odobrimo.
# Novi paket koji traži build biće prijavljen pri instalaciji, ne tiho izvršen.
auto-install-peers=false
